// Code checks for content pages: every ```rok block compiles and
// runs, and its stdout matches the ```output block right after it.
//
//   ```rok          build and run (the default)
//   ```rok build    build only (servers, stdin readers, endless loops)
//   ```rok norun    not checked (fragments, REPL sessions)
//   ```text check=checks/x.rok
//                   `rokc check` of that file prints these lines, in this
//                   order (lines left out of the block are allowed)

use rok::std::fs;
use rok::std::process::{Command, ExitStatus, Stdio};
use rok::std::thread;
use rok::core::par;
use rok::core::task::time::{Duration, Instant};

pub struct Snippet {
    /// Page source, relative to the content root (`learn/03-functions.md`).
    pub page: str;
    /// 1-based line of the opening fence.
    pub line: usize;
    pub code: str;
    /// `run`, `build`, `norun`, or `diag` (a ```text check=<file> block:
    /// `code` is that file's path, `expect` the diagnostics).
    pub mode: str;
    pub expect: str | none;
}

fn fence_len(t: str) -> usize {
    let n = 0usize;
    for c in t.chars() {
        if c != '`' { break; }
        n += 1;
    }
    n
}

/// The ```rok blocks of `text`, with their expected output.
pub fn extract(page: str, text: str) -> List<Snippet> {
    let lines: List<str> = List::new();
    for l in text.lines() { lines.push(l); }
    let out: List<Snippet> = List::new();
    let i = 0usize;
    while i < lines.len() {
        let t = lines[i].trim_start();
        let n = fence_len(t);
        if n < 3 {
            i += 1;
            continue;
        }
        let info: List<str> = List::new();
        for w in t[n:].split_whitespace() { info.push(w); }
        let start = i;
        let body = StrBuf::new();
        i += 1;
        while i < lines.len() && !(fence_len(lines[i].trim_start()) >= n && lines[i].trim()[n:].trim().is_empty()) {
            body.push_str(lines[i]);
            body.push('\n');
            i += 1;
        }
        i += 1;
        if info.len() > 1 && info[0] == "text" && info[1].starts_with("check=") {
            out.push(Snippet { page: page, line: start + 1, code: info[1]["check=".len():], mode: "diag", expect: body.to_str() });
            continue;
        }
        if info.len() == 0 || info[0] != "rok" { continue; }
        let mode = if info.len() > 1 { info[1] } else { "run" };
        let s = Snippet { page: page, line: start + 1, code: body.to_str(), mode: mode, expect: none };
        // An ```output block after blank lines only.
        let j = i;
        while j < lines.len() && lines[j].trim().is_empty() { j += 1; }
        if j < lines.len() && lines[j].trim() == "```output" {
            let exp = StrBuf::new();
            j += 1;
            while j < lines.len() && lines[j].trim() != "```" {
                exp.push_str(lines[j]);
                exp.push('\n');
                j += 1;
            }
            s.expect = exp.to_str();
            i = j + 1;
        }
        out.push(s);
    }
    out
}

fn file_name(s: Snippet) -> str {
    let base = s.page.replace(".md", "").replace("/", "-");
    f"{base}-L{s.line}"
}

/// Run `rokc` with `args` (outputs into `dir/<name>.out` / `.err`); exit
/// status, or `none` after `limit`.
fn run(rokc: str, args: List<str>, dir: str, name: str, limit: Duration) throws -> bool | none {
    let child = try Command::new(rokc)
        .args(args)
        .stdin(Stdio::Null)
        .stdout(Stdio::File(try fs::File::create(f"{dir}/{name}.out")))
        .stderr(Stdio::File(try fs::File::create(f"{dir}/{name}.err")))
        .spawn();
    let t0 = Instant::now();
    loop {
        if let st: ExitStatus = try child.try_wait() { return st.success(); }
        if t0.elapsed() > limit {
            try child.kill();
            try child.wait();
            return none;
        }
        thread::sleep(Duration::ms(20));
    }
}

fn first_lines(s: str, n: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for l in s.lines() {
        if k == n { out.push_str("    ...\n"); break; }
        out.push_str("    " + l + "\n");
        k += 1;
    }
    out.to_str()
}

/// Check one snippet; a failure report, or `""`.
fn check_one(rokc: str, root: str, dir: str, s: Snippet) -> str {
    let at = f"{s.page}:{s.line}";
    if s.mode == "diag" { return try check_diag(rokc, root, dir, s, at) catch e { f"{at}: {e}\n" }; }
    try check_snippet(rokc, dir, s, at) catch e { f"{at}: {e}\n" }
}

/// The diagnostic lines of `rokc check` output, without the status lines
/// and with `prefix` (the scratch directory) cut from paths.
fn diag_lines(out: str, prefix: str) -> List<str> {
    let ls: List<str> = List::new();
    for l in out.replace(prefix, "").lines() {
        let t = l.trim_start();
        if t.starts_with("Checking ") || t.starts_with("Checked ") || t.starts_with("Finished ") { continue; }
        ls.push(l.trim_end());
    }
    while ls.len() > 0 && ls[ls.len() - 1].is_empty() { ls.pop(); }
    ls
}

/// Whether `want` is `got` with lines left out: the same first line, the
/// rest in order.
pub fn diag_matches(want: List<str>, got: List<str>) -> bool {
    if want.len() == 0 || got.len() == 0 || want[0] != got[0] { return false; }
    let k = 0usize;
    for l in got {
        if k < want.len() && l == want[k] { k += 1; }
    }
    k == want.len()
}

fn check_diag(rokc: str, root: str, dir: str, s: Snippet, at: str) throws -> str {
    let name = file_name(s);
    let sub = f"{dir}/{name}".replace("//", "/");
    try fs::create_dir_all(sub);
    try fs::write(f"{sub}/main.rok", try fs::read_to_str(root + "/" + s.code));
    try run(rokc, ["check", f"{sub}/main.rok"], dir, name, Duration::sec(60));
    let got = diag_lines((try fs::read_to_str(f"{dir}/{name}.err")) + (try fs::read_to_str(f"{dir}/{name}.out")), sub + "/");
    let want = diag_lines(s.expect ?? "", "");
    if diag_matches(want, got) { return ""; }
    let shown = StrBuf::new();
    for l in got { shown.push_str(l + "\n"); }
    f"{at}: {s.code}: rokc check prints something else\n  documented:\n{first_lines(s.expect ?? "", 12)}  got:\n{first_lines(shown.to_str(), 12)}"
}

fn check_snippet(rokc: str, dir: str, s: Snippet, at: str) throws -> str {
    let name = file_name(s);
    let src = f"{dir}/{name}.rok";
    try fs::write(src, s.code);
    let cmd = if s.mode == "build" { "build" } else { "run" };
    let ok = try run(rokc, ["-q", cmd, src, "--target-dir", f"{dir}/{name}.target"], dir, name, Duration::sec(60));
    let out = try fs::read_to_str(f"{dir}/{name}.out");
    let err = try fs::read_to_str(f"{dir}/{name}.err");
    if !(ok is bool) { return f"{at}: timed out\n"; }
    if !(ok ?? false) { return f"{at}: {cmd} failed\n{first_lines((err + out).replace(dir + "/", ""), 12)}"; }
    if let e: str = s.expect {
        if out.trim_end() != e.trim_end() {
            return f"{at}: output differs\n  expected:\n{first_lines(e, 12)}  got:\n{first_lines(out, 12)}";
        }
    }
    ""
}

/// Check `snips` in parallel; the failure reports.
pub fn check_all(rokc: str, root: str, dir: str, snips: List<Snippet>) throws -> List<str> {
    try fs::create_dir_all(dir);
    let todo: List<Snippet> = List::new();
    for s in snips {
        if s.mode != "norun" { todo.push(s); }
    }
    let reports = par::map(todo, |s: Snippet| check_one(rokc, root, dir, s));
    let bad: List<str> = List::new();
    for r in reports {
        if !r.is_empty() { bad.push(r); }
    }
    bad
}

#[test]
fn extracts_blocks() {
    let md = "# t\n\n```rok\nprintln(\"a\");\n```\n\n```output\na\n```\n\n````rok build\nlet s = \"```\";\n````\n\n```rok norun\nx\n```\n\n```bash\nls\n```\n";
    let ss = extract("p.md", md);
    assert(ss.len() == 3, "three rok blocks");
    assert(ss[0].mode == "run" && ss[0].line == 3 && (ss[0].expect ?? "") == "a\n", "run + output");
    assert(ss[1].mode == "build" && ss[1].code == "let s = \"```\";\n", "longer fence");
    assert(ss[2].mode == "norun" && ss[2].expect is none, "norun");
}

#[test]
fn diagnostics_allow_left_out_lines() {
    let got = ["error[E1]: x", "  --> main.rok:1:1", "   |", "   = help: y"];
    assert(diag_matches(["error[E1]: x", "   = help: y"], got), "elided location");
    assert(!diag_matches(["error[E1]: z"], got), "first line differs");
    assert(!diag_matches(["error[E1]: x", "   = help: w"], got), "help differs");
}
