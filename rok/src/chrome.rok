// Markup the Rok sites share: the theme controls theme.js drives, the
// social links, the bar of Rok sites, the footer, and the <head> lines
// for fonts, icons and theme.js. Hrefs and text are escaped here; column
// links come as HTML.

/// HTML-escaped `s`, for text and attribute values.
pub fn esc(s: str) -> str {
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

/// The webfonts (kit::FONTS_DIR, published as fonts/), from the site root: the two Geist files
/// rok.css asks for on every page, preloaded so the text does not reflow
/// when they land, and Pretendard's stylesheet, which only Korean text
/// uses.
pub const FONT_FILES: [str; 2] = ["fonts/Geist-Variable.woff2", "fonts/GeistMono-Variable.woff2"];
pub const PRETENDARD: str = "fonts/pretendard.css";

/// theme.js, blocking: it must run before the first paint. `root` leads
/// to the site root (`/`, or `../` from a page one level down). Put it
/// right after `<meta name="theme-color">`.
pub fn theme_script(root: str) -> str { f"<script src=\"{root}theme.js\"></script>\n" }

/// The font preloads and Pretendard's stylesheet, from `/`.
pub fn fonts() -> str { fonts_in("/", true) }

/// fonts() from `root` (the same root as rok.css, so a preload and the
/// stylesheet's request are one URL); Pretendard's stylesheet only if
/// the page holds Korean text (`ko`).
pub fn fonts_in(root: str, ko: bool) -> str {
    let b = StrBuf::new();
    for f in FONT_FILES { b.push_str(f"<link rel=\"preload\" href=\"{root}{f}\" as=\"font\" type=\"font/woff2\" crossorigin>\n"); }
    if ko { b.push_str(f"<link rel=\"stylesheet\" href=\"{root}{PRETENDARD}\">\n"); }
    b.to_str()
}

/// The kit's icons (kit.rok names them), under `root`.
pub fn icons(root: str) -> str {
    f"<link rel=\"icon\" href=\"{root}logo.svg\" type=\"image/svg+xml\">
<link rel=\"icon\" href=\"{root}favicon.ico\" sizes=\"32x32\">
<link rel=\"apple-touch-icon\" href=\"{root}apple-touch-icon.png\">
"
}

pub const ICON_THEME: str = "<svg class=\"moon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg><svg class=\"sun\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>";

/// The header's theme button. Its name stays "Dark theme" and
/// aria-pressed says whether it is on; theme.js keeps aria-pressed and
/// the title (the action) in step.
pub fn theme_button(ko: bool) -> str {
    let (label, title) = if ko { ("다크 테마", "다크 테마로 바꾸기") } else { ("Dark theme", "Switch to dark theme") };
    f"<button class=\"ib theme\" type=\"button\" aria-label=\"{label}\" aria-pressed=\"false\" title=\"{title}\">{ICON_THEME}</button>"
}

/// The footer's System / Light / Dark switch.
pub fn theme_seg(ko: bool) -> str {
    let (lang, group, sys, light, dark) = if ko { ("ko", "테마", "시스템", "라이트", "다크") } else { ("en", "Theme", "System", "Light", "Dark") };
    f"<span class=\"seg\" role=\"group\" aria-label=\"{group}\" lang=\"{lang}\"><button type=\"button\" data-theme-set=\"auto\" aria-pressed=\"false\">{sys}</button><button type=\"button\" data-theme-set=\"light\" aria-pressed=\"false\">{light}</button><button type=\"button\" data-theme-set=\"dark\" aria-pressed=\"false\">{dark}</button></span>"
}

