// The sites' address rules, for the servers and the generators alike:
// no `.html`, a directory is its own address (no `/index`), no trailing
// slash but on the root `/`.

/// `href` split into its path and the `?query#fragment` after it.
pub fn split_ref(href: str) -> (str, str) {
    let k = href.len();
    if let q: usize = href.find("?") { k = q; }
    if let h: usize = href.find("#") {
        if h < k { k = h; }
    }
    (href[:k], href[k:])
}

/// The canonical form of path `p` (absolute or relative, no query):
/// `/a/b.html`, `/a/b/`, `/a/b/index.html`, `/a/b/index` are all `/a/b`.
/// Repeated slashes collapse, so `//host` never leaves the site. An
/// absolute path that runs out is `/`, a relative one `""`.
pub fn canon(p: str) -> str {
    let abs = p.starts_with("/");
    let segs: List<str> = List::new();
    for s in p.split("/") {
        if !s.is_empty() { segs.push(s); }
    }
    if segs.len() > 0 {
        let last = segs[segs.len() - 1];
        if let b: str = last.strip_suffix(".html") { last = b; }
        if last == "index" || last.is_empty() {
            segs.pop();
        } else {
            segs[segs.len() - 1] = last;
        }
    }
    let path = segs.join("/");
    if abs { "/" + path } else { path }
}

/// The canonical form of request path `path`, or none when it is
/// canonical already (`canon`). A path with a backslash is left alone:
/// `/\host` would leave the site.
pub fn canonical(path: str) -> str | none {
    if path.contains("\\") { return none; }
    let c = canon(path);
    if c == path { none } else { c }
}

/// The `Location` header of a 301 from a request to `to`, query kept.
pub fn moved(to: str, query: str) -> str {
    if query.is_empty() { f"Location: {to}" } else { f"Location: {to}?{query}" }
}

/// Absolute path of `href` read on a page in directory `dir`
/// (absolute, `/latest/learn`); `.` and `..` resolved.
pub fn resolve(dir: str, href: str) -> str {
    let full = if href.starts_with("/") { href } else { dir + "/" + href };
    let segs: List<str> = List::new();
    for s in full.split("/") {
        if s.is_empty() || s == "." { continue; }
        if s == ".." {
            if segs.len() > 0 { segs.pop(); }
            continue;
        }
        segs.push(s);
    }
    "/" + segs.join("/")
}

/// True for an href that leaves the site or stays on the page.
fn foreign(href: str) -> bool {
    href.is_empty() || href.starts_with("#") || href.starts_with("//") || href.contains("://") || href.starts_with("mailto:") || href.starts_with("data:")
}

/// `href` on a page in `dir` as the canonical root-relative address it
/// names (`05-sum-types.html#x` in `/latest/learn` ->
/// `/latest/learn/05-sum-types#x`). Others' and fragment-only hrefs
/// stay as they are.
pub fn site_href(dir: str, href: str) -> str {
    if foreign(href) { return href; }
    let (path, rest) = split_ref(href);
    if path.is_empty() { return href; }
    canon(resolve(dir, path)) + rest
}

/// True for an `href` / `src` that names a static file (`rok.css`,
/// `logo.svg`) by a relative path: it breaks on a directory page served
/// without its trailing slash, so no generated page may carry one.
pub fn relative_asset(v: str) -> bool {
    if foreign(v) || v.starts_with("/") { return false; }
    let path = split_ref(v).0;
    for ext in [".css", ".js", ".svg", ".png", ".ico", ".json", ".woff2"] {
        if path.ends_with(ext) { return true; }
    }
    false
}

#[cfg(test)]
fn expect(got: str, want: str) {
    if got != want { panic(f"got `{got}`, want `{want}`"); }
}

#[test]
fn canonical_paths() {
    expect(canon("/"), "/");
    expect(canon("/index.html"), "/");
    expect(canon("/index"), "/");
    expect(canon("/latest/"), "/latest");
    expect(canon("/latest/index.html"), "/latest");
    expect(canon("/latest/learn/index"), "/latest/learn");
    expect(canon("/latest/learn/05-sum-types.html"), "/latest/learn/05-sum-types");
    expect(canon("/latest/learn/05-sum-types"), "/latest/learn/05-sum-types");
    expect(canon("/index.html/"), "/");
    expect(canon("//evil.example/"), "/evil.example");
    expect(canon("/rok.css"), "/rok.css");
    expect(canon("/latest/search-index.json"), "/latest/search-index.json");
    expect(canon("/.well-known/security.txt"), "/.well-known/security.txt");
    expect(canon("learn/index.html"), "learn");
    expect(canon("index.html"), "");
    expect(canon("std/core/str.html"), "std/core/str");
}

#[test]
fn request_paths() {
    let c = |p: str| canonical(p) ?? "=";
    assert(c("/") == "=" && c("/stones") == "=" && c("/stones/json/versions") == "=", "canonical already");
    assert(c("/rok.css") == "=" && c("/og/json.png") == "=" && c("/search-index.json") == "=", "assets");
    assert(c("/index.html") == "/" && c("/index") == "/" && c("//") == "/", "root");
    assert(c("/stones/") == "/stones" && c("/stones/index") == "/stones" && c("/stones/index.html") == "/stones", "directory");
    assert(c("/stones/json.html") == "/stones/json" && c("/stones/json/versions/") == "/stones/json/versions", "page");
    assert(c("/stones/index.html/") == "/stones" && c("/stones//json") == "/stones/json", "repeated");
    assert(c("//evil.example/") == "/evil.example" && c("/\\evil.example/") == "=", "never off the site");
    assert(c("/indexer") == "=" && c("/my-index") == "=", "index only as a segment");
    assert(moved("/a", "") == "Location: /a" && moved("/a", "q=x") == "Location: /a?q=x", "query kept");
}

#[test]
fn hrefs() {
    expect(site_href("/latest/learn", "05-sum-types.html#x"), "/latest/learn/05-sum-types#x");
    expect(site_href("/latest/learn", "../index.html"), "/latest");
    expect(site_href("/latest/learn", "./"), "/latest/learn");
    expect(site_href("/latest", "learn/index.html"), "/latest/learn");
    expect(site_href("/latest/spec/x", "../../rok.css"), "/latest/rok.css");
    expect(site_href("/0.1.0/learn", "../../latest/learn/01.html"), "/latest/learn/01");
    expect(site_href("/", "download.html#archives"), "/download#archives");
    expect(site_href("/", "index.html"), "/");
    expect(site_href("/", "/roadmap.html?a=1"), "/roadmap?a=1");
    expect(site_href("/x", "#top"), "#top");
    expect(site_href("/x", "#"), "#");
    expect(site_href("/x", "https://a.example/b.html"), "https://a.example/b.html");
    expect(site_href("/x", "mailto:a@b"), "mailto:a@b");
    expect(site_href("/x", "//cdn.example/a.css"), "//cdn.example/a.css");
    expect(split_ref("a#b?c").0, "a");
}

#[test]
fn relative_assets() {
    assert(relative_asset("rok.css"), "bare name");
    assert(relative_asset("../../rok.css?v=1"), "up and query");
    assert(relative_asset("./logo.svg"), "dot");
    assert(!relative_asset("/latest/rok.css"), "root-relative");
    assert(!relative_asset("https://cdn.example/a.css"), "foreign");
    assert(!relative_asset("//cdn.example/a.js"), "scheme-relative");
    assert(!relative_asset("learn/05-sum-types"), "page");
    assert(!relative_asset("#rok.css"), "fragment");
}
